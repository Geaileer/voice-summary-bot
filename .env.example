# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to GitHub - it is already listed in .gitignore.

# Telegram bot token - get one from @BotFather on Telegram.
BOT_TOKEN=

# Groq API key (free) - get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides (defaults shown) ---------------------------------

# Speech-to-text model. "whisper-large-v3-turbo" is faster and cheaper;
# "whisper-large-v3" is the full-accuracy model.
# STT_MODEL=whisper-large-v3-turbo

# Summarization model (any Groq chat model works).
# SUMMARY_MODEL=llama-3.3-70b-versatile

# Max voice messages accepted per session (spec: 1-10).
# MAX_VOICES_PER_SESSION=10

# Max size (MB) accepted per voice message. Telegram bots cannot download
# files over 20 MB via the standard Bot API, so raising this above 20 has
# no effect unless you run your own local Bot API server.
# MAX_VOICE_FILE_SIZE_MB=20

# Timeout (seconds) for each request to the Groq API.
# REQUEST_TIMEOUT_SECONDS=120

# How long to wait before the single automatic retry on a rate-limit error.
# RATE_LIMIT_RETRY_DELAY_SECONDS=5
